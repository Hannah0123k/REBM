{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Lets a runtime import name an explicit ".ts" file. Needed by
    // lib/newsletter/notify.ts, which imports the contact form's Resend
    // helpers at runtime: the bare Node test runner cannot resolve the "@/"
    // alias and ESM will not resolve an extensionless relative specifier, so
    // the extension has to be explicit. Safe with noEmit — it permits the
    // form, it does not require it.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "tests", "scripts", "migration"]
}
