# Real Estate Broker Match — environment variables (example; no real secrets here)
# Copy to .env.local and fill in. NEVER prefix a secret or a recipient with
# NEXT_PUBLIC_ — that would ship it to the browser bundle.

# --- Site ---
NEXT_PUBLIC_SITE_URL=               # canonical origin, e.g. https://realestatebrokermatch.com (used for absolute OG/canonical URLs)

# --- Supabase (blog/CMS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # public anon key. OR set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY below (newer Supabase name); either works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # alternative to ANON_KEY — the code accepts either name
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose (CLI/migration scripts only — NOT used by the running app)

# --- Contact form email (Resend) ---
# Server-only. The contact form sends the internal notification to BOTH Alan and
# Rhett. Recipients are read ONLY from these server vars — the browser can never
# set them.
RESEND_API_KEY=                     # Resend API key (server-only)
CONTACT_FROM_EMAIL=                 # verified Resend sender, e.g. REBM <no-reply@realestatebrokermatch.com>
CONTACT_RECIPIENT_ALAN=            # Alan's inbox  <-- enter Alan's address here
CONTACT_RECIPIENT_RHETT=          # Rhett's inbox <-- enter Rhett's address here

# --- Newsletter signup (Resend Audiences) ---
# Server-only. The article "Subscribe to our email list" form adds contacts to a
# Resend audience. Until BOTH are set, the form stays honest — it shows a "not
# live yet" notice instead of faking a signup. Reuses RESEND_API_KEY above.
RESEND_NEWSLETTER_AUDIENCE_ID=     # Resend audience id the newsletter subscribes to

# Optional:
# CONTACT_RECIPIENT_EMAIL=         # legacy single recipient; used only if neither ALAN nor RHETT is set
# CONTACT_REPLY_TO_FALLBACK=       # reply-to used only if a visitor email is ever missing (it never is)
# CONTACT_CONFIRMATION_ENABLED=true  # turn ON the branded visitor auto-reply (default OFF; needs a verified sender domain)

# --- Figma (design tooling only) ---
FIGMA_TOKEN=
